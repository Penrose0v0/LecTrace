# LecTrace 配置模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）

# ---- Gemini（Catchup 摘要，必填）----
# 从 https://aistudio.google.com/apikey 申请
GEMINI_API_KEY=
# 低延迟场景用 flash 系列
GEMINI_MODEL=gemini-2.5-flash
# 讲义语言（转录内容语言）：ja（默认） / zh / en
LECTURE_LANGUAGE=ja
# 用户语言（摘要输出语言）：ja（默认） / zh / en
USER_LANGUAGE=ja

# ---- 转录源 ----
# demo：replay（回放归档 session）；目标：google-stt
TRANSCRIPTION_SOURCE=replay
# 归档数据目录（回放用），相对仓库根
DEMO_DATA_DIR=_archive/data
# 回放加速倍率：8 ≈ 1 小时讲义 7.5 分钟放完
REPLAY_SPEED=8
REPLAY_MAX_GAP_SEC=2.0

# ---- 存储 ----
# memory（默认，进程内）或 firestore（持久化：卡片/对话/转录）
STORE_BACKEND=memory
# firestore 时用：GCP 项目 ID + 数据库名
GCP_PROJECT=
FIRESTORE_DATABASE=(default)
# 本地用模拟器测试时设置（生产留空，走 ADC）：
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8410
