# LecTrace 配置模板 —— 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）

# ---- LLM（Catchup 摘要 + AI 对话）----
# 提供方：siliconflow（默认）/ openai / gemini
LLM_PROVIDER=siliconflow
# SiliconFlow（OpenAI 兼容协议，从 https://cloud.siliconflow.cn 申请）
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3.5-122B-A10B
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI：实时转录（source=openai-stt）用这个 key；LLM_PROVIDER=openai 时也作为 LLM
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 实时转录模型（source=openai-stt 时用）
# gpt-realtime-whisper=原生流式(推荐,连续讲课不碎片)；gpt-4o-transcribe=非流式(会碎片)
OPENAI_STT_MODEL=gpt-realtime-whisper
# VAD 静音阈值(ms)：合并短停顿
OPENAI_STT_SILENCE_MS=800

# Gemini（备选，LLM_PROVIDER=gemini 时用；从 https://aistudio.google.com/apikey 申请）
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# 讲义语言（转录内容语言）：ja（默认） / zh / en
LECTURE_LANGUAGE=ja
# 用户语言（摘要输出语言）：ja（默认） / zh / en
USER_LANGUAGE=ja

# ---- 转录源 ----
# openai-stt（OpenAI 实时）/ google-stt（Google 实时）/ replay（回放归档）
TRANSCRIPTION_SOURCE=openai-stt
# 归档数据目录（回放用），相对仓库根
DEMO_DATA_DIR=_archive/data
# 回放加速倍率：8 ≈ 1 小时讲义 7.5 分钟放完
REPLAY_SPEED=8
REPLAY_MAX_GAP_SEC=2.0

# ---- 录音保存（麦克风原始 PCM，按 take 存）----
# off（默认不存）/ local（写到 RECORDINGS_DIR，本地开发）/ gcs（写到 RECORDINGS_BUCKET）
RECORDINGS=off
RECORDINGS_DIR=data/recordings
RECORDINGS_BUCKET=

# ---- 登录（Google Sign-In）----
# OAuth 2.0 Web 客户端 ID（GCP Console → APIs & Services → Credentials → Create OAuth client ID → Web）
# 留空且不在 Cloud Run 上时，自动开启本地开发登录（/api/auth/dev）
GOOGLE_CLIENT_ID=
# 会话 cookie 签名密钥（生产必填，例：openssl rand -hex 32）；留空则每次重启登录态失效
SESSION_SECRET=
# 登录态有效天数
SESSION_DAYS=30
# 允许登录的邮箱白名单（逗号分隔）；留空则任何 Google 账号都能登录并消耗 LLM 额度
ALLOWED_EMAILS=
# 管理员（不受下面配额限制）
ADMIN_EMAILS=
# 非管理员配额：单节课转录时长上限（分钟）、每天最多新建几节课；0 = 不限
QUOTA_MAX_LECTURE_MINUTES=60
QUOTA_MAX_LECTURES_PER_DAY=3
QUOTA_TIMEZONE=Asia/Tokyo
# 强制开/关本地开发登录（默认：无 client id 且非 Cloud Run 时开）
# AUTH_DEV_LOGIN=1

# ---- 存储 ----
# memory（默认，进程内）或 firestore（持久化：卡片/对话/转录）
STORE_BACKEND=memory
# firestore 时用：GCP 项目 ID + 数据库名
GCP_PROJECT=
FIRESTORE_DATABASE=(default)
# 本地用模拟器测试时设置（生产留空，走 ADC）：
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8410
